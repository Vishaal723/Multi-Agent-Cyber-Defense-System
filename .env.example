# Copy these names into the process environment; this file contains no usable secrets.
MACDS_ENV=development
JWT_SECRET_KEY=
MACDS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
MACDS_DB_PATH=

# First-run account provisioning. Keep demo mode false unless this is an isolated local demo.
MACDS_DEMO_MODE=false
MACDS_BOOTSTRAP_ADMIN_USERNAME=
MACDS_BOOTSTRAP_ADMIN_PASSWORD=
MACDS_BOOTSTRAP_ADMIN_EMAIL=

# Set true only when serving the backend over HTTPS.
MACDS_COOKIE_SECURE=false
